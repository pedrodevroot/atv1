{
  "name": "cinebridge-recomendacao",
  "version": "0.1.0",
  "description": "CineBridge - microsserviço de recomendação e orquestração de equipes audiovisuais",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:desempenho": "vitest run --project desempenho",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f recomendacao",
    "docker:reset": "docker compose down -v",
    "migration:run": "tsx src/infrastructure/database/scripts/migrar.ts",
    "migration:revert": "tsx src/infrastructure/database/scripts/reverter-migracao.ts",
    "seed": "tsx src/infrastructure/database/scripts/semear.ts",
    "perf": "tsx tests/perf/carga.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrodevroot/atv1.git"
  },
  "keywords": [
    "cinebridge",
    "fastify",
    "typeorm",
    "design-patterns"
  ],
  "author": "pxdev__",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pedrodevroot/atv1/issues"
  },
  "homepage": "https://github.com/pedrodevroot/atv1#readme",
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "typebox": "^1.3.34",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
